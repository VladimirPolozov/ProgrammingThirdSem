<Window x:Class="ProgrammingThirdSem.Ales.Views.GenerateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Generate" Height="250" Width="250">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Мин. значение" FontFamily="Montserrat" FontSize="12px" Margin="0 0 0 5"/>
            <TextBox x:Name="MinValueTextBox" FontFamily="Montserrat" FontSize="12px" Margin="0 0 0 10"/>
            <TextBlock Text="Макс. значение" FontFamily="Montserrat" FontSize="12px" Margin="0 0 0 5"/>
            <TextBox x:Name="MaxValueTextBox" FontFamily="Montserrat" FontSize="12px" Margin="0 0 0 10"/>            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Margin="0 0 5px 0" Grid.Column="0" Click="Cancel_Click" IsCancel="True" FontWeight="Medium" Background="#24A1DE" Foreground="White" BorderThickness="0" Padding="16 4">Отмена</Button>
                <Button Margin="5px 0 0 0" Grid.Column="1" Click="Accept_Click"  IsDefault="True" FontWeight="Medium" Background="#24A1DE" Foreground="White" BorderThickness="0" Padding="32 4">OK</Button>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
